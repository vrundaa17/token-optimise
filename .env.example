# Choose ONE provider and set its key

# Option 1 — Groq (free)
GROQ_API_KEY=your_groq_key_here

# Option 2 — OpenAI
# OPENAI_API_KEY=your_openai_key_here

# Option 3 — Anthropic
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Option 4 — DeepSeek
# DEEPSEEK_API_KEY=your_deepseek_key_here

# Option 5 — Ollama (local, no key needed)
# no key required

# Model to use — must match your provider prefix
LLM_MODEL=groq/llama-3.3-70b-versatile

# Optional: comma-separated fallback models if primary fails
# LLM_FALLBACKS=groq/llama-3.1-8b-instant,groq/gemma2-9b-it

ALLOWED_DIR=/Users/yourname
EMBEDDER=all-MiniLM-L6-v2
API_PORT=7737
DASHBOARD_PORT=7738